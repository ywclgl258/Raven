QQ_BOT_APP_ID=replace-with-app-id
QQ_BOT_APP_SECRET=replace-with-app-secret
QQ_BOT_SANDBOX=false
# Required: comma separated QQ openids allowed to message the bot one-to-one.
# One of the two allowlists must be non-empty or the bridge refuses to start.
QQ_BOT_ALLOWED_USERS=
# Required: comma separated group openids where the bot may run commands.
QQ_BOT_ALLOWED_GROUPS=
OMP_REPO_ROOT=D:/Raven
OMP_COMMAND=omp
OMP_TIMEOUT_SECONDS=300
OMP_EXTRA_ARGS=--no-session
